{
    "name": "Chipyard RISC-V SoC",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "chipyard",
    "workspaceFolder": "/workspace",
    "remoteUser": "root",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "files.watcherExclude": {
                    "**/target/**": true,
                    "**/project/target/**": true,
                    "**/sims/verilator/generated-src/**": true,
                    "**/sims/verilator/simulator-*": true
                }
            },
            "extensions": [
                "scalameta.metals",
                "ms-vscode.cpptools",
                "mshr-h.veriloghdl"
            ]
        }
    },
    "postStartCommand": "source /opt/chipyard-env.sh",
    "forwardPorts": [],
    "shutdownAction": "stopCompose"
}
