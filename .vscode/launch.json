{
    "version": "0.2.0",
    "configurations": [

        // ============================================================
        // [2] Software Build
        // ============================================================
        {
            "name": "[2] Software: Build All Programs",
            "type": "node-terminal",
            "request": "launch",
            "command": "for d in Cipher MatMul MTHello; do echo '=== Building '$d' ==='; make -C ${workspaceFolder}/demoriscv/software/$d clean && make -C ${workspaceFolder}/demoriscv/software/$d || exit 1; done",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "[2] Software: Build Cipher + Simulate",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/demoriscv/software/Cipher clean && make -C ${workspaceFolder}/demoriscv/software/Cipher && spike pk ${workspaceFolder}/demoriscv/software/Cipher/build/cipher.elf",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "[2] Software: Build MatMul + Simulate",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/demoriscv/software/MatMul clean && make -C ${workspaceFolder}/demoriscv/software/MatMul && spike pk ${workspaceFolder}/demoriscv/software/MatMul/build/matmul.elf",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "[2] Software: Build MTHello + Simulate",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/demoriscv/software/MTHello clean && make -C ${workspaceFolder}/demoriscv/software/MTHello && spike -p4 ${workspaceFolder}/demoriscv/software/MTHello/build/mt-hello.elf",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "[2] BootROM: Build Basic",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/demoriscv/src/main/resources/bootROM/basic clean && make -C ${workspaceFolder}/demoriscv/src/main/resources/bootROM/basic",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "[2] BootROM: Build MTBoot",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/demoriscv/src/main/resources/bootROM/MTBoot clean && make -C ${workspaceFolder}/demoriscv/src/main/resources/bootROM/MTBoot",
            "cwd": "${workspaceFolder}"
        },

        // ============================================================
        // [3] Spike ISA Simulation
        // ============================================================
        {
            "name": "[3] Spike: Run ELF Binary",
            "type": "node-terminal",
            "request": "launch",
            "command": "spike ${input:binaryPath}",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "[3] Spike: Run with Proxy Kernel (pk)",
            "type": "node-terminal",
            "request": "launch",
            "command": "spike pk ${input:binaryPath}",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "[3] Spike: Interactive Debug",
            "type": "node-terminal",
            "request": "launch",
            "command": "spike -d ${input:binaryPath}",
            "cwd": "${workspaceFolder}"
        },

        // ============================================================
        // [4] HW Generation: Chisel/Scala → FIRRTL → Verilog
        // ============================================================
        {
            "name": "[4] HW Gen: Elaborate Only (generate Verilog)",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/sims/verilator CONFIG=${input:simConfig} elaborate",
            "cwd": "${workspaceFolder}/sims/verilator"
        },
        {
            "name": "[4] HW Gen: SBT Compile (Chisel → FIRRTL)",
            "type": "node-terminal",
            "request": "launch",
            "command": "sbt compile",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "[4] HW Gen: SBT Test",
            "type": "node-terminal",
            "request": "launch",
            "command": "sbt test",
            "cwd": "${workspaceFolder}"
        },

        // ============================================================
        // [4] Verilator RTL Simulation
        // ============================================================
        {
            "name": "[4] Verilator: Build Simulator Only",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/sims/verilator CONFIG=${input:simConfig}",
            "cwd": "${workspaceFolder}/sims/verilator"
        },
        {
            "name": "[4] Verilator: Build & Run (RocketConfig)",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/sims/verilator CONFIG=RocketConfig run-binary BINARY=${input:binaryPath}",
            "cwd": "${workspaceFolder}/sims/verilator"
        },
        {
            "name": "[4] Verilator: Build & Run Debug + Waveform",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/sims/verilator CONFIG=${input:simConfig} run-binary-debug BINARY=${input:binaryPath}",
            "cwd": "${workspaceFolder}/sims/verilator"
        },

        // ============================================================
        // [4] VCS RTL Simulation
        // ============================================================
        {
            "name": "[4] VCS: Build & Run",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/sims/vcs CONFIG=${input:simConfig} run-binary BINARY=${input:binaryPath}",
            "cwd": "${workspaceFolder}/sims/vcs"
        },
        {
            "name": "[4] VCS: Build & Run Debug + Waveform",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/sims/vcs CONFIG=${input:simConfig} run-binary-debug BINARY=${input:binaryPath}",
            "cwd": "${workspaceFolder}/sims/vcs"
        },

        // ============================================================
        // [4] VLSI / Hammer Flow
        // ============================================================
        {
            "name": "[4] VLSI: RTL Simulation",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/vlsi sim-rtl CONFIG=${input:simConfig} BINARY=${input:binaryPath}",
            "cwd": "${workspaceFolder}/vlsi"
        },
        {
            "name": "[4] VLSI: RTL Simulation Debug",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/vlsi sim-rtl-debug CONFIG=${input:simConfig} BINARY=${input:binaryPath}",
            "cwd": "${workspaceFolder}/vlsi"
        },

        // ============================================================
        // [5] FPGA Build & Deploy
        // ============================================================
        {
            "name": "[5] DemoRISCV FPGA (VC707): Full Build",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/demoriscv bitstream SUB_PROJECT=vc707",
            "cwd": "${workspaceFolder}/demoriscv"
        },
        {
            "name": "[5] DemoRISCV FPGA (Arty100T): Full Build",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/demoriscv bitstream SUB_PROJECT=arty100t",
            "cwd": "${workspaceFolder}/demoriscv"
        },
        {
            "name": "[5] DemoRISCV FPGA (Arty100T): Build & Download",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/demoriscv everything SUB_PROJECT=arty100t",
            "cwd": "${workspaceFolder}/demoriscv"
        },
        {
            "name": "[5] Chipyard FPGA: Build Bitstream",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/fpga bitstream SUB_PROJECT=${input:fpgaBoard}",
            "cwd": "${workspaceFolder}/fpga"
        },

        // ============================================================
        // Docker Workflows
        // ============================================================
        {
            "name": "Docker: Build Image & Start",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker compose build && docker compose up -d && docker compose exec chipyard bash",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Docker: Verilator Build (in container)",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker compose exec chipyard bash -c 'source /opt/chipyard-env.sh && cd sims/verilator && make CONFIG=${input:simConfig}'",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Docker: Verilator Run Binary (in container)",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker compose exec chipyard bash -c 'source /opt/chipyard-env.sh && cd sims/verilator && make run-binary CONFIG=${input:simConfig} BINARY=${input:binaryPath}'",
            "cwd": "${workspaceFolder}"
        },

        // ============================================================
        // Clean
        // ============================================================
        {
            "name": "Clean: Generated Verilog (elaborate outputs)",
            "type": "node-terminal",
            "request": "launch",
            "command": "rm -rf ${workspaceFolder}/sims/verilator/generated-src",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Clean: Verilator Simulator Build",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/sims/verilator clean",
            "cwd": "${workspaceFolder}/sims/verilator"
        },
        {
            "name": "Clean: VCS Simulator Build",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/sims/vcs clean",
            "cwd": "${workspaceFolder}/sims/vcs"
        },
        {
            "name": "Clean: Software (all programs)",
            "type": "node-terminal",
            "request": "launch",
            "command": "for d in Cipher MatMul MTHello; do make -C ${workspaceFolder}/demoriscv/software/$d clean; done",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Clean: FPGA DemoRISCV Build",
            "type": "node-terminal",
            "request": "launch",
            "command": "make -C ${workspaceFolder}/demoriscv clean",
            "cwd": "${workspaceFolder}/demoriscv"
        },
        {
            "name": "Clean: ALL (generated-src + sims + software + fpga)",
            "type": "node-terminal",
            "request": "launch",
            "command": "echo '=== Clean generated Verilog ===' && rm -rf ${workspaceFolder}/sims/verilator/generated-src && echo '=== Clean Verilator ===' && make -C ${workspaceFolder}/sims/verilator clean && echo '=== Clean VCS ===' && make -C ${workspaceFolder}/sims/vcs clean 2>/dev/null || true && echo '=== Clean Software ===' && for d in Cipher MatMul MTHello; do make -C ${workspaceFolder}/demoriscv/software/$d clean; done && echo '=== Clean FPGA ===' && make -C ${workspaceFolder}/demoriscv clean 2>/dev/null || true && echo '=== Done ==='",
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "simConfig",
            "description": "Chipyard Configuration Class",
            "type": "pickString",
            "options": [
                "RocketConfig",
                "TinyRocketConfig",
                "QuadCoreVC707Config",
                "MTArty100TConfig",
                "HwachaRocketConfig",
                "LargeBoomV3Config",
                "MediumBoomV3Config",
                "SmallBoomV3Config",
                "RoCCExampleConfig",
                "Sha3RocketConfig"
            ],
            "default": "RocketConfig"
        },
        {
            "id": "binaryPath",
            "description": "Path to RISC-V ELF binary",
            "type": "promptString",
            "default": "${workspaceFolder}/demoriscv/software/Cipher/build/cipher.elf"
        },
        {
            "id": "fpgaBoard",
            "description": "FPGA Board Target",
            "type": "pickString",
            "options": [
                "vcu118",
                "vc707",
                "arty100t",
                "arty35t",
                "nexysvideo"
            ],
            "default": "vc707"
        }
    ]
}
